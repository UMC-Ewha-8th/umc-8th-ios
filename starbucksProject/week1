import SwiftUI

struct LoginView: View {
    @State private var loginModel = LoginModel()
    
    enum Field: Hashable {
            case id
            case pwd
        }
    
    @FocusState private var focusedField: Field?
    //@FocusState는 SwiftUI에서 텍스트 필드의 포커스 상태(=입력 중인지 여부)를 추적하고 제어하기 위해 사용
    //private var focusedField: Field? -> 현재 포커스를 받은 필드를 구분하기 위한 변수
    //Field는 enum으로 정의되어 있어야 함

    
    var body: some View {
        
        VStack{
            
            //하단 title VStack
            VStack(alignment: .leading){ //중앙이아니라왼쪽에정렬하기위함 -> 내부정렬
                
                Image(.starbucsLogo)
                    .resizable()
                    .frame(width: 97, height: 95)
                    .padding(.bottom, 28) //글이랑로고패딩규격
                //양옆 간격 19px
                
                Text("안녕하세요.\n스타벅스입니다.")
                    .font(.PretendardExtraBold24)
                    .foregroundColor(.black03)
                    .padding(.bottom, 19) //아래글이랑패딩규격
                
                Text("회원 서비스 이용을 위해 로그인 해주세요")
                    .font(.PretendardMedium16)
                    .foregroundColor(.gray01)
                
            }
            .frame(maxWidth: .infinity, alignment: .leading)
            .padding(.horizontal, 19)
            .padding(.top, 40)
            
            
            VStack{
                VStack (alignment: .leading){
                    VStack(alignment: .leading){
                        
                        TextField("아이디", text: $loginModel.userId)
                            .font(.PretendardRegular13)
                            .foregroundColor(.black01)  //블랙적용안되는이유가뭘까..
                        Divider()
                            .foregroundColor(.gray00)
                        
                    }
                    .padding(.bottom, 20)
                    
                    VStack (alignment: .leading) {
                        
                        TextField("비밀번호", text: $loginModel.userId)
                            .font(.PretendardRegular13)
                            .foregroundColor(.black01)
                        Divider()
                            .foregroundColor(.gray00)
                    }
                    .padding(.bottom, 20)
                    
                    
                    Button(action:{
                        print("아이디: \(loginModel.userId), 비밀번호: \(loginModel.password)")
                    }) {
                        Text("로그인하기")
                            .font(.PretendardMedium16)
                            .foregroundColor(.white01)
                            .frame(maxWidth: .infinity)
                            .padding()
                            .background(Color.green01)
                            .cornerRadius(20)
                    }
                    
                    
                }
                .frame(maxWidth: .infinity, alignment: .leading)
                .padding(.horizontal, 19)
                .padding(.top, 60)
                
            }
            
            
            VStack (alignment: .center){
                
                Text("이메일로 회원가입하기")
                    .font(.PretendardRegular12)
                    .foregroundColor(.gray04)
                    .underline()
                    .padding(.bottom, 19)
                
                Image(.kakaologin)
                    .resizable()
                    .frame(width: 306, height: 45)
                    .padding(.bottom, 19) //글이랑로고패딩규격
                
                Image(.applelogin)
                    .resizable()
                    .frame(width: 306, height: 45)
                
            }
            
            .frame(maxWidth: .infinity, alignment: .center)
            .padding(.horizontal, 19)
            .padding(.top, 80)
            
        }
        
        
    }
}
    
    
   
            
           

